@using Microsoft.AspNetCore.Identity
@using nhahangchay.Models
@* Tiêm công cụ UserManager vào thẳng giao diện *@
@inject UserManager<AppUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">

	<title>@ViewData["Title"] - SenVie Vegan Dining</title>
	<meta name="keywords" content="">
	<meta name="description" content="">
	<meta name="author" content="">

	<link rel="shortcut icon" href="~/images/favicon.ico" type="image/x-icon" />
	<link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />

	<link rel="stylesheet" href="~/css/bootstrap.min.css">
	<link rel="stylesheet" href="~/css/style.css">
	<link rel="stylesheet" href="~/css/responsive.css">
	<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
	<script src="~/js/modernizr.js"></script>
</head>
<body id="page-top" class="politics_version">

	<div id="preloader">
		<div id="main-ld">
			<div id="loader"></div>
		</div>
	</div>

	<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
		<div class="container-fluid">
			<a class="navbar-brand js-scroll-trigger" href="#page-top">
				<img class="img-fluid" src="~/images/logo.png" alt="" />
			</a>
			<button class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
				Menu
				<i class="fa fa-bars"></i>
			</button>
			<div class="collapse navbar-collapse" id="navbarResponsive">
				<ul class="navbar-nav ml-auto">

					@{
						// Lấy tên Controller và Action hiện tại
						var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
						var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

						// Kiểm tra xem có phải đang ở Trang chủ không (Bao gồm cả trường hợp mặc định lúc mới mở web)
						bool isHome = (string.IsNullOrEmpty(currentController) || currentController == "Home")
									  && (string.IsNullOrEmpty(currentAction) || currentAction == "Index");

						// Thuật toán Tắc kè hoa: Ở nhà thì không có gạch chéo, đi xa thì thêm gạch chéo để chỉ đường về
						var prefix = isHome ? "" : "/";
					}
					<li class="nav-item"><a class="nav-link js-scroll-trigger @(isHome ? "active" : "")" href="@prefix#home"><span>Trang chủ</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#about"><span>Giới thiệu</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#menu"><span>Menu</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#gallery"><span>Thư viện ảnh</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#chef"><span>Đầu bếp</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#pricing"><span>Dịch vụ tiệc</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#blog"><span>Tin tức</span></a></li>
					<li class="nav-item"><a class="nav-link js-scroll-trigger" href="@prefix#contact"><span>Liên hệ</span></a></li>

					<style>
						/* Trạng thái bình thường của nút Chào */
						.user-greeting {
						color: #7DBA4E !important;
						font-weight: bold;
						}

						/* Trạng thái khi di chuột (Hover) */
						.user-greeting:hover {
						color: #ffffff !important;
						}
					</style>

					@if (!isHome)
					{
						<style>
							/* Ghi đè CSS của ScrollSpy: Tước màu nền nâu, trả lại màu chữ mặc định */
							#navbarResponsive .nav-item .nav-link.active {
							background-color: transparent !important;
							color: #222222 !important;
							}
							/* Giữ lại hiệu ứng đổi màu xanh khi người dùng chủ động rê chuột */
							#navbarResponsive .nav-item .nav-link:hover {
							color: #7DBA4E !important;
							}
						</style>
					}

					@if (User.Identity.IsAuthenticated)
					{
						// --- LOGIC MỚI: TỰ ĐỘNG TÌM HỌ TÊN KHÁCH HÀNG ---
						var currentUser = await UserManager.GetUserAsync(User);
						var displayName = currentUser != null ? currentUser.FullName : User.Identity.Name;
						// -----------------------------------------------

						@if (User.Identity.Name == "admin@uef.com")
						{
							// 1. Nếu là Admin: Thêm nút Quản lý Chat và in ra tên Admin
							<li class="nav-item">
								<a class="nav-link" asp-controller="Admin" asp-action="ChatManager" style="color: #7DBA4E !important; font-weight: bold; border: 1px solid #7DBA4E; border-radius: 20px; padding: 5px 15px !important; margin-top: 3px; margin-right: 10px;">
									<i class="fa fa-comment-dots"></i> Quản lý Chat
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link user-greeting" asp-controller="Admin" asp-action="Index" title="Vào Trạm Quản Trị">
									<i class="fa fa-user-shield"></i> Chào, @displayName
								</a>
							</li>
						}
						else
						{
							// 2. Nếu là Khách hàng: In ra bằng displayName
							<li class="nav-item">
								<a class="nav-link user-greeting" asp-controller="Account" asp-action="Profile" title="Trang cá nhân">
									<i class="fa fa-user-circle"></i> Chào, @displayName
								</a>
							</li>
						}

						<li class="nav-item">
							<a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng Xuất</a>
						</li>
					}
					else
					{
						// 3. Khách vãng lai chưa đăng nhập
						<li class="nav-item">
							<a class="nav-link" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-controller="Account" asp-action="Register" style="background-color: #7DBA4E; color: white; border-radius: 5px; padding: 8px 15px !important; margin-left: 10px;">Đăng Ký</a>
						</li>
					}
				</ul>
			</div>
		</div>
	</nav>

	<main role="main">
		@RenderBody()
	</main>

	<footer class="main-footer">
		<div class="container">
			<div class="row">
				<div class="col-lg-3 col-md-6 col-sm-12">
					<div class="mb-3 img-logo">
						<a href="#">
							<img src="~/images/logo.png" />
						</a>
						<p>Nhà hàng ẩm thực thuần chay.</p>
					</div>
				</div>
				<div class="col-lg-3 col-md-6 col-sm-12">
					<h4 class="mb-4 ph-fonts-style foot-title">
						Recent Link
					</h4>
					<ul class="ph-links-column">
						<li><a href="#" class="text-black">About us</a></li>
						<li><a href="#" class="text-black">Services</a></li>
						<li><a href="#" class="text-black">Contact Us</a></li>
					</ul>
				</div>
				<div class="col-lg-3 col-md-6 col-sm-12">
					<h4 class="mb-4 ph-fonts-style foot-title">
						Contact Us
					</h4>
					<div class="cont-box-footer">
						<div class="cont-line">
							<div class="icon-b">
								<i class="fa fa-map-signs" aria-hidden="true"></i>
							</div>
							<div class="cont-dit">
								<p>Hồ Chí Minh, Việt Nam</p>
							</div>
						</div>
						<div class="cont-line">
							<div class="icon-b">
								<i class="fa fa-volume-control-phone" aria-hidden="true"></i>
							</div>
							<div class="cont-dit">
								<p><a href="#">+84 123 456 789</a></p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-md-6 col-sm-12">
					<h4 class="mb-4 ph-fonts-style foot-title">
						SUBSCRIBE
					</h4>
					<p class="ph-fonts-style_p">
						Nhận thông tin cập nhật hàng tháng.
					</p>
					<div class="media-container-column" data-form-type="formoid">
						<form class="form-inline" action="#" method="post">
							<div class="form-group">
								<input class="form-control input-sm input-inverse my-2" name="email" required="" data-form-field="Email" placeholder="Email" id="email" type="email">
							</div>
							<div class="input-group-btn">
								<button href="" class="btn hvr-radial-in btn-primary" type="submit" role="button"><span> Subscribe </span></button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</footer>

	<div class="copyrights">
		<div class="container-fluid">
			<div class="footer-distributed">
				<div class="footer-left">
					<p class="footer-company-name">All Rights Reserved. &copy; 2026 <a href="#">Vegan Restaurant</a></p>
				</div>
			</div>
		</div>
	</div>

	<a href="#" id="scroll-to-top" class="dmtop global-radius"><i class="fa fa-angle-up"></i></a>

	<script src="~/js/all.js"></script>
	<script src="~/js/jquery.easing.1.3.js"></script>
	<script src="~/js/parallaxie.js"></script>
	<script src="~/js/headline.js"></script>
	<script src="~/js/owl.carousel.js"></script>
	<script src="~/js/jquery.nicescroll.min.js"></script>
	<script src="~/js/jqBootstrapValidation.js"></script>
	<script src="~/js/contact_me.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.imagesloaded/4.1.4/imagesloaded.pkgd.min.js"></script>
	<script src="~/js/custom.js"></script>
	@* chat box *@
	@if (!User.Identity.IsAuthenticated || User.Identity.Name != "admin@uef.com")
    {
        <button id="btn-toggle-chat" class="guest-chat-toggle" type="button" aria-label="Mở hộp chat hỗ trợ">
            <i class="fa fa-comments"></i>
            <span class="guest-chat-pulse"></span>
        </button>

        <div id="chat-wrapper" class="guest-chat-wrapper">
            <div class="guest-chat-header">
                <div class="guest-chat-title">
                    <div class="guest-chat-avatar">
                        <i class="fa fa-leaf"></i>
                    </div>
                    <div>
                        <strong>Hỗ trợ khách hàng</strong>
                        <span>SenVie luôn sẵn sàng hỗ trợ</span>
                    </div>
                </div>

                <button id="btn-close-chat" class="guest-chat-close" type="button" title="Đóng">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <div class="guest-chat-intro">
                <strong>Xin chào!</strong> Bạn cần hỗ trợ đặt bàn, thực đơn hoặc dịch vụ tiệc chay?
            </div>

            <div id="chat-history" class="guest-chat-history"></div>

            <div class="guest-chat-input-area">
                <input type="text"
                       id="chat-message"
                       class="guest-chat-input"
                       placeholder="Nhập tin nhắn..."
                       autocomplete="off" />

                <button id="btn-send-chat" class="guest-chat-send" type="button">
                    <span>Gửi</span>
                    <i class="fa fa-paper-plane"></i>
                </button>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
		<script>
			var isAuthenticated = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.IsAuthenticated == true));
			var loginName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? ""));
			var chatHistoryLoaded = false;

			function getOrCreateGuestRoomId() {
			var storageKey = "senvie_guest_room_id";

			try {
			var savedRoomId = localStorage.getItem(storageKey);

			if (savedRoomId) {
			return savedRoomId;
			}

			var newRoomId = "";

			if (window.crypto && crypto.randomUUID) {
			newRoomId = "Guest_" + crypto.randomUUID().replace(/-/g, "").substring(0, 12);
			} else {
			newRoomId = "Guest_" + Date.now() + "_" + Math.random().toString(36).substring(2, 10);
			}

			localStorage.setItem(storageKey, newRoomId);
			return newRoomId;
			} catch (e) {
			return "Guest_" + Date.now() + "_" + Math.random().toString(36).substring(2, 10);
			}
			}

			var roomId = isAuthenticated ? loginName : getOrCreateGuestRoomId();
			var userName = isAuthenticated ? loginName : "Khách";

			function getChatTime() {
			var now = new Date();
			return now.getHours() + ":" + now.getMinutes().toString().padStart(2, "0");
			}

			function renderMessage(sender, message) {
			var isAdmin = sender === "Admin";
			var senderLabel = isAdmin ? "Admin" : "Bạn";

			var $messageBox = $("<div></div>")
			.addClass("msg-box")
			.addClass(isAdmin ? "msg-admin" : "msg-guest");

			$("<b></b>")
			.text(senderLabel + ":")
			.appendTo($messageBox);

			$("<span></span>")
			.addClass("message-text")
			.text(message)
			.appendTo($messageBox);

			$("<span></span>")
			.addClass("time-text")
			.text(getChatTime())
			.appendTo($messageBox);

			$("#chat-history").append($messageBox);
			$("#chat-history").scrollTop($("#chat-history")[0].scrollHeight);
			}

			function loadChatHistoryOnce() {
			if (chatHistoryLoaded || !$("#chat-history").is(":empty")) {
			return;
			}

			chatHistoryLoaded = true;

			$.get("/api/chat/history?roomId=" + encodeURIComponent(roomId), function (messages) {
			if (messages && messages.length > 0) {
			messages.forEach(function (m) {
			renderMessage(m.senderName, m.message);
			});
			}
			}).fail(function () {
			console.warn("Không tải được lịch sử chat.");
			});
			}

			$("#btn-toggle-chat").click(function () {
			$("#chat-wrapper").fadeToggle(250);
			$("#btn-toggle-chat").removeClass("has-unread");

			loadChatHistoryOnce();

			setTimeout(function () {
			$("#chat-message").focus();
			}, 280);
			});

			$("#btn-close-chat").click(function () {
			$("#chat-wrapper").fadeOut(250);
			});

			var connection = new signalR.HubConnectionBuilder()
			.withUrl("/chatHub")
			.withAutomaticReconnect()
			.build();

			connection.on("ReceiveMessage", function (rId, sender, message) {
			if (rId && rId !== roomId) {
			return;
			}

			renderMessage(sender, message);

			if ($("#chat-wrapper").is(":hidden") && sender === "Admin") {
			$("#btn-toggle-chat").addClass("has-unread");
			}
			});

			connection.start()
			.then(function () {
			return connection.invoke("JoinRoom", roomId, false);
			})
			.catch(function (err) {
			console.warn("Không thể kết nối chat:", err);
			});

			$("#btn-send-chat").click(function () {
			var msg = $("#chat-message").val().trim();

			if (msg === "") {
			return;
			}

			if (connection.state !== signalR.HubConnectionState.Connected) {
			alert("Chat chưa kết nối. Vui lòng thử lại sau vài giây.");
			return;
			}

			var $sendButton = $("#btn-send-chat");
			$sendButton.prop("disabled", true);

			connection.invoke("SendMessageToAdmin", roomId, userName, msg)
			.then(function () {
			$("#chat-message").val("");
			})
			.catch(function (err) {
			console.warn("Không gửi được tin nhắn:", err);
			alert("Tin nhắn chưa gửi được. Vui lòng thử lại sau.");
			})
			.finally(function () {
			$sendButton.prop("disabled", false);
			$("#chat-message").focus();
			});
			});

			$("#chat-message").keypress(function (e) {
			if (e.which === 13) {
			e.preventDefault();
			$("#btn-send-chat").click();
			}
			});
		</script>
    }

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>