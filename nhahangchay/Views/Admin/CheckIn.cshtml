@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Trạm Quét QR - SenVie Admin</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin-custom.css" asp-append-version="true" />
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

</head>
<body class="senvie-admin-page admin-checkin-page">

    <nav class="admin-navbar admin-checkin-navbar">
        <a class="admin-brand" href="/Admin">
            <span class="admin-brand-icon"><i class="fas fa-arrow-left"></i></span>
            <span>Quay lại Admin</span>
        </a>

        <div class="admin-nav-actions">
            <span class="admin-hello">Trạm QR Check-in</span>
            <a href="/" class="admin-site-btn">Xem Website</a>
        </div>
    </nav>

    <main class="admin-checkin-shell">
        <div class="admin-checkin-heading">
            <p class="admin-eyebrow">SenVie Restaurant</p>
            <h1><i class="fas fa-qrcode"></i> Check-in đặt bàn</h1>
            <p>Quét mã QR từ email xác nhận hoặc nhập mã đặt bàn thủ công.</p>
        </div>

        <div class="admin-checkin-alerts">
            @if (TempData["Success"] != null)
            {
                <div class="admin-checkin-alert success">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="admin-checkin-alert error">
                    <i class="fas fa-times-circle"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="admin-checkin-alert warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>@TempData["Warning"]</span>
                </div>
            }
        </div>

        <div class="admin-checkin-grid">
            <section class="admin-checkin-card scanner-card">
                <div class="admin-checkin-card-header green">
                    <div>
                        <strong>Quét bằng camera</strong>
                        <span>Đưa mã QR vào giữa khung quét</span>
                    </div>
                    <i class="fas fa-camera"></i>
                </div>

                <div class="admin-checkin-card-body">
                    <div class="admin-reader-wrap">
                        <div id="reader"></div>
                    </div>

                    <div id="scanner-status" class="admin-scanner-status info">
                        Bấm “Bật camera” để cấp quyền và bắt đầu quét QR.
                    </div>

                    <div class="admin-camera-actions">
                        <button type="button" id="startCameraBtn" class="admin-camera-start-btn">
                            <i class="fas fa-video"></i>
                            Bật camera
                        </button>

                        <button type="button" id="retryCameraBtn" class="admin-camera-retry-btn" style="display:none;">
                            <i class="fas fa-redo"></i>
                            Thử lại
                        </button>
                    </div>
                </div>
            </section>

            <section class="admin-checkin-card manual-card">
                <div class="admin-checkin-card-header dark">
                    <div>
                        <strong>Nhập mã thủ công</strong>
                        <span>Dùng khi QR khó quét hoặc camera lỗi</span>
                    </div>
                    <i class="fas fa-keyboard"></i>
                </div>

                <div class="admin-checkin-card-body manual-body">
                    <form id="checkInForm" asp-controller="Admin" asp-action="ProcessCheckIn" method="post">
                        <label class="admin-checkin-label">
                            Mã đặt bàn
                            <small>Ví dụ: GS-PQYSTK</small>
                        </label>

                        <input type="text"
                               id="bookingCodeInput"
                               name="bookingCode"
                               class="admin-checkin-input"
                               placeholder="NHẬP MÃ VÀO ĐÂY"
                               autocomplete="off"
                               required />

                        <button type="submit" class="admin-checkin-submit">
                            <i class="fas fa-check-circle"></i>
                            Xác nhận check-in
                        </button>
                    </form>

                    <div class="admin-checkin-tips">
                        <h3>Lưu ý nhanh</h3>
                        <ul>
                            <li>Mã hợp lệ thường bắt đầu bằng <strong>GS-</strong>.</li>
                            <li>Khách đã check-in sẽ được hệ thống cảnh báo.</li>
                            <li>Nếu camera không bật, hãy kiểm tra quyền camera của trình duyệt.</li>
                        </ul>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        var readerId = "reader";
        var statusBox = document.getElementById("scanner-status");
        var bookingCodeInput = document.getElementById("bookingCodeInput");
        var checkInForm = document.getElementById("checkInForm");
        var startCameraBtn = document.getElementById("startCameraBtn");
        var retryCameraBtn = document.getElementById("retryCameraBtn");

        var qrScanner = null;
        var isProcessing = false;
        var isScannerStarted = false;
        var startTimeout = null;

        function setScannerStatus(message, type) {
        if (!statusBox) return;

        statusBox.className = "admin-scanner-status " + (type || "info");
        statusBox.innerText = message;
        }

        function setCameraButtons(isStarting, canRetry) {
        if (startCameraBtn) {
        startCameraBtn.disabled = isStarting;
        startCameraBtn.style.display = isScannerStarted ? "none" : "inline-flex";
        }

        if (retryCameraBtn) {
        retryCameraBtn.style.display = canRetry ? "inline-flex" : "none";
        }
        }

        function getScannerConfig() {
        var isMobile = window.matchMedia("(max-width: 768px)").matches;
        var qrSize = isMobile
        ? Math.min(Math.max(Math.floor(window.innerWidth * 0.55), 180), 230)
        : 250;

        return {
        fps: 10,
        qrbox: {
        width: qrSize,
        height: qrSize
        },
        aspectRatio: 1.0
        };
        }

        function extractBookingCode(rawText) {
        var value = (rawText || "").trim();

        if (!value) return "";

        try {
        var url = new URL(value);

        value =
        url.searchParams.get("bookingCode") ||
        url.searchParams.get("code") ||
        url.pathname.split("/").filter(Boolean).pop() ||
        value;
        } catch (e) {
        }

        var match = value.match(/GS-[A-Z0-9]+/i);

        if (match) {
        value = match[0];
        }

        return value.trim().toUpperCase();
        }

        function onScanSuccess(decodedText) {
        if (isProcessing) return;

        var bookingCode = extractBookingCode(decodedText);

        if (!bookingCode) {
        setScannerStatus("QR không chứa mã đặt bàn hợp lệ.", "warning");
        return;
        }

        isProcessing = true;

        bookingCodeInput.value = bookingCode;
        setScannerStatus("Đã quét được mã " + bookingCode + ". Đang xử lý check-in...", "success");

        if (qrScanner) {
        qrScanner.stop()
        .then(function () {
        checkInForm.submit();
        })
        .catch(function () {
        checkInForm.submit();
        });
        } else {
        checkInForm.submit();
        }
        }

        function onScanFailure() {
        }

        function startScannerWithCameraSource(cameraSource) {
        return qrScanner.start(
        cameraSource,
        getScannerConfig(),
        onScanSuccess,
        onScanFailure
        );
        }

        function startScanner() {
        if (isProcessing) return;

        if (typeof Html5Qrcode === "undefined") {
        setScannerStatus("Không tải được thư viện quét QR. Vui lòng kiểm tra kết nối mạng.", "error");
        setCameraButtons(false, true);
        return;
        }

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        setScannerStatus("Trình duyệt không cho phép dùng camera. Hãy mở bằng HTTPS và cấp quyền camera.", "error");
        setCameraButtons(false, true);
        return;
        }

        if (!qrScanner) {
        qrScanner = new Html5Qrcode(readerId);
        }

        isScannerStarted = false;
        setCameraButtons(true, false);
        setScannerStatus("Đang xin quyền camera. Hãy bấm Cho phép nếu trình duyệt hỏi quyền.", "info");

        clearTimeout(startTimeout);

        startTimeout = setTimeout(function () {
        if (!isScannerStarted) {
        setScannerStatus("Camera chưa phản hồi. Hãy kiểm tra quyền camera hoặc bấm Thử lại.", "warning");
        setCameraButtons(false, true);
        }
        }, 9000);

        startScannerWithCameraSource({ facingMode: "environment" })
        .then(function () {
        clearTimeout(startTimeout);
        isScannerStarted = true;
        setScannerStatus("Camera đã sẵn sàng. Đưa mã QR vào khung quét.", "success");
        setCameraButtons(false, false);
        })
        .catch(function () {
        Html5Qrcode.getCameras()
        .then(function (devices) {
        if (!devices || devices.length === 0) {
        throw new Error("Không tìm thấy camera.");
        }

        var backCamera = devices.find(function (device) {
        return /back|rear|environment/i.test(device.label);
        });

        var cameraId = backCamera ? backCamera.id : devices[0].id;

        return startScannerWithCameraSource(cameraId);
        })
        .then(function () {
        clearTimeout(startTimeout);
        isScannerStarted = true;
        setScannerStatus("Camera đã sẵn sàng. Đưa mã QR vào khung quét.", "success");
        setCameraButtons(false, false);
        })
        .catch(function () {
        clearTimeout(startTimeout);
        setScannerStatus("Không mở được camera. Hãy cấp quyền camera, đóng app đang dùng camera hoặc thử trình duyệt khác.", "error");
        setCameraButtons(false, true);
        });
        });
        }

        startCameraBtn?.addEventListener("click", startScanner);
        retryCameraBtn?.addEventListener("click", startScanner);

        setCameraButtons(false, false);
        });
    </script>
</body>
</html>