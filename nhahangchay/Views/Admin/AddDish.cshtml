@model nhahangchay.Models.Dish
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm món ăn";
    ViewData["DishFormMode"] = "add";
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow">Quản lý thực đơn</p>
        <h1>Thêm món ăn mới</h1>
        <p class="admin-subtitle">Upload ảnh món ăn và lưu thông tin vào menu SenVie.</p>
    </div>

    <a asp-controller="Admin" asp-action="Dishes" class="admin-btn admin-btn-reset">
        <i class="fas fa-arrow-left"></i>
        <span>Quay lại thực đơn</span>
    </a>
</div>

<section class="admin-dish-form-card">
    <form asp-action="AddDish"
          method="post"
          enctype="multipart/form-data"
          onsubmit="return senvieAddDishSubmitOnce(this);">
        @Html.AntiForgeryToken()
        <partial name="_DishFormFields" model="Model" />
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function senvieAddDishSubmitOnce(form) {
            if (!form) {
                return true;
            }

            if (form.dataset.submitted === 'true') {
                return false;
            }

            if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
                return true;
            }

            form.dataset.submitted = 'true';

            var buttons = form.querySelectorAll('button, input[type="submit"]');

            buttons.forEach(function (button) {
                button.disabled = true;

                if (button.tagName.toLowerCase() === 'button') {
                    button.dataset.originalText = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Đang thêm món...';
                } else {
                    button.value = 'Đang thêm món...';
                }
            });

            return true;
        }
    </script>
}
