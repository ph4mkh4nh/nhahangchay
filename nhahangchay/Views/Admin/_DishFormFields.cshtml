@model nhahangchay.Models.Dish
@{
    var mode = ViewData["DishFormMode"]?.ToString() ?? "add";
    var isEdit = mode == "edit";
    var hasImage = isEdit && !string.IsNullOrEmpty(Model?.ImageUrl);
    var uploadText = isEdit ? "Đổi ảnh món ăn" : "Chọn ảnh món ăn";
    var submitText = isEdit ? "Cập nhật món ăn" : "Lưu món ăn";
}

<div class="admin-dish-grid">
    <div class="admin-dish-preview">
        <div class="admin-dish-preview-box">
            <img id="dishImagePreview"
                 src="@(hasImage ? Model.ImageUrl : "")"
                 alt="Xem trước ảnh món ăn"
                 style="@(hasImage ? "" : "display: none;")" />

            <div id="dishImagePlaceholder" style="@(hasImage ? "display: none;" : "")">
                <i class="fas fa-image"></i>
                <strong>Ảnh món ăn</strong>
                <span>Chọn ảnh từ máy để xem trước</span>
            </div>
        </div>

        <label class="admin-upload-btn">
            <i class="fas fa-cloud-upload-alt"></i>
            @uploadText
            <input type="file"
                   name="imageFile"
                   class="js-dish-image-input"
                   data-preview="#dishImagePreview"
                   data-placeholder="#dishImagePlaceholder"
                   accept="image/*"
                   hidden />
        </label>

        @if (isEdit)
        {
            <small class="text-muted d-block mt-2">Bỏ trống nếu không muốn đổi ảnh.</small>
        }

        <span asp-validation-for="ImageUrl" class="text-danger small d-block mt-2"></span>
    </div>

    <div class="admin-dish-fields">
        <div class="form-group">
            <label>Tên món ăn <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="VD: Lẩu Nấm SenVie, Gỏi Cuốn..." />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Phân loại <span class="text-danger">*</span></label>
                    <select asp-for="Category" class="form-control">
                        <option value="">-- Chọn loại món --</option>
                        <option value="Khai Vị">Khai Vị</option>
                        <option value="Món Chính">Món Chính</option>
                        <option value="Tráng Miệng">Tráng Miệng</option>
                        <option value="Nước Uống">Nước Uống</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Giá tiền (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" min="0" max="10000000" step="1" title="Vui lòng nhập giá từ 0 đến 10.000.000 VNĐ"
                           class="form-control" placeholder="VD: 150000" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Mô tả món ăn</label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Giới thiệu thành phần, hương vị..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        @if (isEdit)
        {
            <div class="form-group">
                <label class="d-block">Trạng thái hiển thị</label>
                <label class="admin-switch-row">
                    <input asp-for="IsAvailable" type="checkbox" />
                    <span></span>
                    <strong>Cho phép hiển thị trên website khách hàng</strong>
                </label>
            </div>
        }

        <div class="admin-dish-actions">
            <button type="submit" class="admin-primary-action">
                <i class="fas fa-save"></i>
                <span>@submitText</span>
            </button>
        </div>
    </div>
</div>
