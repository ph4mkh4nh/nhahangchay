@model nhahangchay.Models.Booking
@using System.Security.Claims
@using nhahangchay.Models

@{
    var bookingCode = Model.BookingCode ?? "";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var canCancelBooking =
        User.Identity?.IsAuthenticated == true
        && Model.Status == 0
        && !string.IsNullOrEmpty(Model.AppUserId)
        && Model.AppUserId == currentUserId;

    var preOrderDetails = Model.BookingDetails?.ToList() ?? new List<BookingDetail>();
    var preOrderTotal = preOrderDetails.Sum(x => x.LineTotal);

    ViewData["Title"] =
        Model.Status == 2
            ? "Đơn Đã Hủy"
            : Model.DepositAmount > 0 && Model.PaymentStatus == 0
                ? "Thanh Toán Đặt Cọc"
                : "Đặt Bàn Thành Công";
}

<div id="booking-status-page" class="section wb" style="padding: 150px 0 100px 0; min-height: 80vh; background-color: #f4f7f6;">
    <div class="container text-center">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success font-weight-bold text-center mb-4" style="max-width: 650px; margin: 0 auto;">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger font-weight-bold text-center mb-4" style="max-width: 650px; margin: 0 auto;">
                <i class="fas fa-exclamation-triangle"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["MailError"] != null)
        {
            <div class="alert alert-danger font-weight-bold text-center mb-4" style="max-width: 650px; margin: 0 auto;">
                <i class="fas fa-exclamation-triangle"></i>
                CẢNH BÁO TỪ HỆ THỐNG:<br />
                @TempData["MailError"]
            </div>
        }

        @if (Model.Status == 2)
        {
            <div class="success-box" style="background: white; padding: 50px 40px; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.08); max-width: 650px; margin: 0 auto; border-top: 10px solid #dc3545;">

                <i class="fa fa-times-circle" style="font-size: 80px; color: #dc3545; margin-bottom: 20px;"></i>

                <h2 style="font-weight: bold; color: #333; font-size: 2.2rem;">
                    Đơn đặt bàn đã bị hủy
                </h2>

                <p style="font-size: 1.1rem; color: #666; margin-bottom: 25px;">
                    Mã đơn <strong style="color: #dc3545;">@bookingCode</strong> hiện không còn hiệu lực.
                </p>

                <div style="background: #fff5f5; border: 1px dashed #dc3545; border-radius: 15px; padding: 20px; margin-bottom: 25px;">
                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Loại bàn:</strong> @Model.BookingType
                    </p>

                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Thời gian đặt:</strong> @Model.BookingDate.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p style="margin-bottom: 0; color: #333;">
                        <strong>Tiền cọc:</strong> @Model.DepositAmount.ToString("N0")đ
                    </p>
                </div>

                @if (Model.DepositAmount > 0 && Model.PaymentStatus == 1)
                {
                    <div class="alert alert-warning font-weight-bold text-left" style="border-radius: 12px;">                      
                        Đơn này đã thanh toán cọc @Model.DepositAmount.ToString("N0")đ.
                        Nhà hàng sẽ liên hệ để xử lý hoàn cọc hoặc chuyển cọc sang đơn đặt bàn khác.
                    </div>
                }
                else
                {
                    <div class="alert alert-light border font-weight-bold" style="border-radius: 12px;">
                        Đơn này chưa thanh toán cọc nên không phát sinh xử lý hoàn tiền.
                    </div>
                }

                <a href="/" class="hvr-radial-in" style="background-color: #7DBA4E; color: white; padding: 15px 40px; font-size: 1.1rem; border-radius: 50px; text-decoration: none; display: inline-block; font-weight: bold;">
                    Trở Về Trang Chủ
                </a>
            </div>
        }
        else if (Model.DepositAmount > 0 && Model.PaymentStatus == 0)
        {
            <div class="payment-choice-box">
                <div class="payment-choice-header">
                    <span class="payment-badge">Cần thanh toán cọc</span>
                    <h2>Chọn phương thức thanh toán</h2>
                    <p>
                        Đơn đặt bàn cần thanh toán cọc để nhận mã QR check-in.
                        Mã nhận diện sẽ hiển thị sau khi thanh toán thành công.
                    </p>
                </div>

                <div class="payment-summary-card">
                    <div>
                        <span>Số tiền cọc</span>
                        <strong>@Model.DepositAmount.ToString("N0")đ</strong>
                    </div>

                    <div>
                        <span>Loại bàn</span>
                        <strong>@Model.BookingType</strong>
                    </div>

                    @if (Model.BookingType == "Omakase Chay" && !string.IsNullOrWhiteSpace(Model.OmakaseTier))
                    {
                        <div>
                            <span>Gói Omakase</span>
                            <strong>@Model.OmakaseTier</strong>
                        </div>
                    }

                    <div>
                        <span>Thời gian đến</span>
                        <strong>@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>

                @if (preOrderDetails.Any())
                {
                    <div class="payment-preorder-card">
                        <h5>Món đã chọn trước</h5>

                        @foreach (var detail in preOrderDetails)
                        {
                            <div class="payment-preorder-row">
                                <span>@detail.DishName x @detail.Quantity</span>
                                <strong>@detail.LineTotal.ToString("N0")đ</strong>
                            </div>
                        }

                        <div class="payment-preorder-total">
                            <span>Tổng tạm tính</span>
                            <strong>@preOrderTotal.ToString("N0")đ</strong>
                        </div>

                        <p>Tổng tiền món chỉ là tạm tính, thanh toán trực tiếp tại nhà hàng.</p>
                    </div>
                }

                <div class="payment-policy-box">
                    <h5>Chính sách hủy và xử lý tiền cọc</h5>

                    @if (Model.BookingType == "Omakase Chay")
                    {
                        <ul>
                            <li>Hủy trước <strong>48 tiếng</strong>: hỗ trợ hoàn/chuyển <strong>100% tiền cọc</strong>.</li>
                            <li>Hủy từ <strong>24 đến dưới 48 tiếng</strong>: hỗ trợ hoàn/chuyển <strong>50% tiền cọc</strong>.</li>
                            <li>Hủy dưới <strong>24 tiếng</strong>: tiền cọc không được hoàn do nhà hàng đã chuẩn bị nguyên liệu và suất phục vụ riêng.</li>
                        </ul>
                    }
                    else if (Model.BookingType == "Bàn VIP")
                    {
                        <ul>
                            <li>Hủy trước <strong>24 tiếng</strong>: hỗ trợ hoàn/chuyển <strong>100% tiền cọc</strong>.</li>
                            <li>Hủy dưới <strong>24 tiếng</strong>: tiền cọc không được hoàn do nhà hàng đã giữ phòng riêng và chuẩn bị dịch vụ.</li>
                        </ul>
                    }

                    <p>
                        Việc hoàn/chuyển cọc sẽ được nhà hàng liên hệ và xử lý thủ công.
                    </p>

                    <label class="payment-policy-check">
                        <input type="checkbox" id="acceptPaymentPolicy" />
                        <span>Tôi đã đọc và đồng ý với chính sách hủy/hoàn cọc của SenVie.</span>
                    </label>
                </div>

                <div class="payment-method-grid">
                    <div class="payment-method-card momo">
                        <div class="payment-method-logo momo-logo">
                            MoMo
                        </div>

                        <h4>MoMo Demo</h4>
                        <p>Thanh toán mô phỏng 1 click để test nhanh.</p>

                        <div class="payment-demo-note">
                            <strong>Test nhanh</strong>
                            <span>Không cần quét QR, hệ thống sẽ mô phỏng thanh toán thành công.</span>
                        </div>

                        <form asp-controller="Home"
                              asp-action="DemoMoMoPayment"
                              method="post"
                              class="deposit-payment-form">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="code" value="@bookingCode" />
                            <input type="hidden" name="acceptCancellationPolicy" value="false" class="accept-policy-value" />

                            <button type="submit" class="payment-submit-btn momo-btn">
                                Thanh toán MoMo
                            </button>
                        </form>
                    </div>

                    <div class="payment-method-card vnpay">
                        <div class="payment-method-logo vnpay-logo">
                            VNPay
                        </div>

                        <h4>VNPay Sandbox</h4>
                        <p>Chuyển sang cổng VNPay để thanh toán.</p>

                        <div class="payment-vnpay-note">
                            <span>VNPay sẽ chuyển bạn sang trang thanh toán sandbox.</span>
                        </div>

                        <form asp-controller="Payment"
                              asp-action="CreateVnPayPayment"
                              method="post"
                              class="deposit-payment-form">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="code" value="@bookingCode" />
                            <input type="hidden" name="acceptCancellationPolicy" value="false" class="accept-policy-value" />

                            <button type="submit" class="payment-submit-btn vnpay-btn">
                                Thanh toán VNPay
                            </button>
                        </form>
                    </div>
                </div>

                @if (canCancelBooking)
                {
                    <form asp-controller="Home"
                          asp-action="CancelMyBooking"
                          method="post"
                          class="mt-3"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn @bookingCode không?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="code" value="@bookingCode" />

                        <button type="submit" class="payment-cancel-btn">
                            Hủy đơn này
                        </button>
                    </form>
                }

                <div class="payment-back-link">
                    <a href="/">
                        Quay về trang chủ
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="success-box" style="background: white; padding: 50px 40px; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.08); max-width: 650px; margin: 0 auto; border-top: 10px solid #7DBA4E;">

                <i class="fa fa-check-circle" style="font-size: 80px; color: #7DBA4E; margin-bottom: 20px;"></i>

                @if (Model.DepositAmount > 0)
                {
                    <h2 style="font-weight: bold; color: #333; font-size: 2.2rem;">
                        Thanh Toán Thành Công!
                    </h2>
                }
                else
                {
                    <h2 style="font-weight: bold; color: #333; font-size: 2.5rem;">
                        Đặt Bàn Thành Công!
                    </h2>
                }

                <p style="font-size: 1.1rem; color: #666; margin-bottom: 30px;">
                    Cảm ơn bạn đã lựa chọn SenVie. Dưới đây là mã nhận diện đơn hàng của bạn.
                </p>

                <div style="background: #f8fff4; border: 1px dashed #7DBA4E; border-radius: 15px; padding: 18px; margin-bottom: 25px; text-align: left;">
                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Khách hàng:</strong> @Model.CustomerName
                    </p>

                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Loại bàn:</strong> @Model.BookingType
                    </p>

                    @if (Model.BookingType == "Omakase Chay" && !string.IsNullOrWhiteSpace(Model.OmakaseTier))
                    {
                        <p style="margin-bottom: 8px; color: #333;">
                            <strong>Gói Omakase:</strong> @Model.OmakaseTier
                        </p>
                    }

                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Số khách:</strong> @Model.NumberOfGuests
                    </p>

                    <p style="margin-bottom: 8px; color: #333;">
                        <strong>Thời gian đến:</strong> @Model.BookingDate.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p style="margin-bottom: 0; color: #333;">
                        <strong>Tiền cọc:</strong>
                        @if (Model.DepositAmount > 0)
                        {
                            <span>@Model.DepositAmount.ToString("N0")đ - Đã thanh toán</span>
                        }
                        else
                        {
                            <span>Không yêu cầu cọc</span>
                        }
                    </p>
                </div>


                @if (preOrderDetails.Any())
                {
                    <div style="background: #f8fff4; border: 1px solid #d8edce; border-left: 5px solid #7DBA4E; border-radius: 14px; padding: 16px; margin-bottom: 22px; text-align: left;">
                        <h5 style="font-weight: 900; color: #2f6b1f; margin-bottom: 12px;">
                            Món đã chọn trước
                        </h5>

                        @foreach (var detail in preOrderDetails)
                        {
                            <div style="display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed #dbead2; font-size: 14px;">
                                <span>@detail.DishName x @detail.Quantity</span>
                                <strong>@detail.LineTotal.ToString("N0")đ</strong>
                            </div>
                        }

                        <div style="display: flex; justify-content: space-between; margin-top: 12px; font-weight: 900; color: #1f3b20;">
                            <span>Tổng tạm tính</span>
                            <span>@preOrderTotal.ToString("N0")đ</span>
                        </div>

                        <p style="margin: 10px 0 0; color: #777; font-size: 13px;">
                            Tổng tiền món chỉ là tạm tính, thanh toán trực tiếp tại nhà hàng.
                        </p>
                    </div>
                }

                <div class="code-area" style="margin: 30px 0; padding: 30px 20px; background: #f9fbf8; border: 2px dashed #7DBA4E; border-radius: 15px;">
                    <h1 style="font-size: 3.5rem; color: #7DBA4E; letter-spacing: 8px; margin: 0; font-weight: 900;">
                        @bookingCode
                    </h1>

                    <p style="margin-top: 15px; color: #777; font-size: 1rem;">
                        Vui lòng đưa mã này hoặc mã QR bên dưới cho lễ tân khi đến nhà hàng để được phục vụ nhanh nhất.
                    </p>

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=@Uri.EscapeDataString(bookingCode)"
                         alt="QR Code Đặt Bàn"
                         style="margin-top: 25px; border: 8px solid white; border-radius: 10px; box-shadow: 0 6px 15px rgba(0,0,0,0.1);" />
                </div>

                @if (canCancelBooking)
                {
                    <form asp-controller="Home"
                          asp-action="CancelMyBooking"
                          method="post"
                          class="mb-3"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn @bookingCode không?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="code" value="@bookingCode" />

                        <button type="submit"
                                class="btn btn-outline-danger rounded-pill font-weight-bold px-4 py-2">
                            Hủy đơn đặt bàn
                        </button>
                    </form>
                }

                <a href="/" class="hvr-radial-in" style="background-color: #7DBA4E; color: white; padding: 15px 40px; font-size: 1.1rem; border-radius: 50px; text-decoration: none; display: inline-block; font-weight: bold; transition: all 0.3s;">
                    Trở Về Trang Chủ
                </a>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        localStorage.removeItem('senvie_preorder_items');

        document.querySelectorAll('.deposit-payment-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var policyCheckbox = document.getElementById('acceptPaymentPolicy');
                var hiddenPolicyInput = form.querySelector('.accept-policy-value');

                if (!policyCheckbox || !policyCheckbox.checked) {
                    event.preventDefault();
                    alert('Vui lòng đọc và đồng ý với chính sách hủy/hoàn cọc trước khi thanh toán.');
                    return;
                }

                if (hiddenPolicyInput) {
                    hiddenPolicyInput.value = 'true';
                }

                var submitButton = form.querySelector('button[type="submit"]');

                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerText = 'Đang xử lý...';
                }
            });
        });
    </script>
    <style>
        .payment-choice-box {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
            padding: 34px;
            border-radius: 24px;
            background: #ffffff;
            border-top: 10px solid #7DBA4E;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .payment-choice-header h2 {
            margin: 12px 0 8px;
            color: #172236;
            font-size: 32px;
            font-weight: 900;
        }

        .payment-choice-header p {
            color: #667085;
            font-size: 16px;
            margin-bottom: 22px;
        }

        .payment-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 0 16px;
            border-radius: 999px;
            color: #7a4b00;
            background: #fff3cd;
            font-weight: 900;
            font-size: 13px;
            text-transform: uppercase;
        }

        .payment-summary-card {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin: 22px 0;
        }

            .payment-summary-card div {
                padding: 16px;
                border-radius: 16px;
                background: #f8fff4;
                border: 1px solid #d8edce;
                text-align: left;
            }

            .payment-summary-card span {
                display: block;
                margin-bottom: 6px;
                color: #667085;
                font-size: 12px;
                font-weight: 800;
                text-transform: uppercase;
            }

            .payment-summary-card strong {
                color: #1f3b20;
                font-size: 16px;
                font-weight: 900;
            }

        .payment-preorder-card,
        .payment-policy-box {
            margin-bottom: 22px;
            padding: 18px;
            border-radius: 18px;
            text-align: left;
        }

        .payment-preorder-card {
            background: #f8fff4;
            border: 1px solid #d8edce;
            border-left: 5px solid #7DBA4E;
        }

            .payment-preorder-card h5,
            .payment-policy-box h5 {
                margin-bottom: 12px;
                font-weight: 900;
            }

        .payment-preorder-row,
        .payment-preorder-total {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            padding: 9px 0;
            border-bottom: 1px dashed #dbead2;
        }

        .payment-preorder-total {
            border-bottom: none;
            margin-top: 8px;
            color: #1f3b20;
            font-weight: 900;
        }

        .payment-preorder-card p {
            margin: 8px 0 0;
            color: #777;
            font-size: 13px;
        }

        .payment-policy-box {
            background: #fff8e1;
            border-left: 5px solid #ffc107;
            color: #333;
        }

            .payment-policy-box ul {
                padding-left: 18px;
                margin-bottom: 8px;
                line-height: 1.7;
            }

            .payment-policy-box p {
                margin-bottom: 12px;
                color: #777;
                font-size: 13px;
            }

        .payment-policy-check {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            margin: 0;
            padding: 12px;
            border-radius: 12px;
            background: #ffffff;
            font-weight: 800;
            cursor: pointer;
        }

            .payment-policy-check input {
                margin-top: 4px;
            }

        .payment-method-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .payment-method-card {
            padding: 24px;
            border-radius: 22px;
            border: 1px solid #e6e9ef;
            background: #ffffff;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
            text-align: center;
        }

            .payment-method-card.momo {
                border-color: #f2cce3;
                background: #fff7fc;
            }

            .payment-method-card.vnpay {
                border-color: #cde4ff;
                background: #f5f9ff;
            }

        .payment-method-icon {
            width: 68px;
            height: 68px;
            margin: 0 auto 14px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
        }

            .payment-method-icon img {
                max-width: 54px;
                max-height: 54px;
            }

        .vnpay-icon {
            color: #0d6efd;
            font-size: 34px;
        }

        .payment-method-card h4 {
            margin-bottom: 8px;
            color: #172236;
            font-weight: 900;
        }

        .payment-method-card p {
            min-height: 44px;
            margin-bottom: 16px;
            color: #667085;
            font-weight: 600;
            line-height: 1.5;
        }

        .payment-demo-qr img {
            width: 150px;
            height: 150px;
            padding: 6px;
            margin-bottom: 16px;
            border-radius: 14px;
            border: 2px solid #a50064;
            background: #ffffff;
        }

        .payment-vnpay-note {
            min-height: 166px;
            margin-bottom: 16px;
            padding: 20px;
            border-radius: 16px;
            background: #ffffff;
            color: #0d4f8b;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            line-height: 1.5;
        }

            .payment-vnpay-note i {
                font-size: 24px;
            }

        .payment-submit-btn,
        .payment-cancel-btn {
            width: 100%;
            min-height: 50px;
            border: none;
            border-radius: 999px;
            color: #ffffff;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

        .momo-btn {
            background: #a50064;
            box-shadow: 0 8px 18px rgba(165, 0, 100, 0.22);
        }

        .vnpay-btn {
            background: #0d6efd;
            box-shadow: 0 8px 18px rgba(13, 110, 253, 0.22);
        }

        .payment-cancel-btn {
            background: #dc3545;
        }

        .payment-back-link {
            margin-top: 20px;
        }

            .payment-back-link a {
                color: #667085;
                font-weight: 800;
                text-decoration: none;
            }

        @@media (max-width: 768px) {
            #booking-status-page {
                padding: 110px 0 70px 0 !important;
            }

            .payment-choice-box {
                padding: 24px 16px;
                border-radius: 20px;
            }

            .payment-choice-header h2 {
                font-size: 25px;
