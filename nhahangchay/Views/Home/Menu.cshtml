@section Scripts {
    <script>
        (function () {
            var storageKey = "senvie_preorder_items";
            var cart = loadCart();
            var mobileQuery = window.matchMedia('(max-width: 768px)');
            function loadCart() {
                try {
                    return JSON.parse(localStorage.getItem(storageKey) || "[]");
                } catch (e) {
                    return [];
                }
            }

            function saveCart() {
                localStorage.setItem(storageKey, JSON.stringify(cart));
            }

            function formatMoney(value) {
                return (value || 0).toLocaleString('vi-VN') + 'đ';
            }
                    function setPanelCollapsed(isCollapsed) {
            var panel = document.getElementById('preOrderPanel');
            var toggle = document.getElementById('preOrderToggle');

            if (!panel || !toggle) return;

            panel.classList.toggle('is-collapsed', isCollapsed);
            toggle.innerText = isCollapsed ? 'Mở' : 'Thu gọn';
        }

        function syncPanelForMobile() {
            if (mobileQuery.matches) {
                setPanelCollapsed(true);
            }
        }
            function renderCart() {
                var container = document.getElementById('preOrderItems');
                var empty = document.getElementById('preOrderEmpty');
                var count = document.getElementById('preOrderCount');
                var totalEl = document.getElementById('preOrderTotal');

                if (!container || !empty || !count || !totalEl) return;

                container.innerHTML = '';

                var totalQuantity = cart.reduce(function (sum, item) { return sum + item.quantity; }, 0);
                var totalPrice = cart.reduce(function (sum, item) { return sum + item.quantity * item.price; }, 0);

                count.innerText = totalQuantity + ' món';
                totalEl.innerText = formatMoney(totalPrice);
                empty.style.display = cart.length ? 'none' : 'block';

                cart.forEach(function (item) {
                    var row = document.createElement('div');
                    row.className = 'preorder-item';

                    row.innerHTML =
                        '<div>' +
                            '<div class="preorder-item-name"></div>' +
                            '<div class="preorder-item-price"></div>' +
                        '</div>' +
                        '<div class="preorder-qty-controls">' +
                            '<button type="button" data-action="minus" data-id="' + item.dishId + '">-</button>' +
                            '<strong>' + item.quantity + '</strong>' +
                            '<button type="button" data-action="plus" data-id="' + item.dishId + '">+</button>' +
                        '</div>';

                    row.querySelector('.preorder-item-name').innerText = item.name;
                    row.querySelector('.preorder-item-price').innerText = formatMoney(item.price);

                    container.appendChild(row);
                });
            }

            function addToCart(dishId, name, price) {
                var existing = cart.find(function (item) { return item.dishId === dishId; });

                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({ dishId: dishId, name: name, price: price, quantity: 1 });
                }

                   saveCart();
                   renderCart();

                    if (mobileQuery.matches) {
                        setPanelCollapsed(true);
                    }
            }

            document.addEventListener('click', function (event) {
                var addButton = event.target.closest('.js-add-preorder');

                if (addButton) {
                    var dishId = parseInt(addButton.dataset.dishId);
                    var name = addButton.dataset.name || '';
                    var price = parseFloat(addButton.dataset.price || '0');

                    if (!dishId || !name) return;

                    addToCart(dishId, name, price);
                    addButton.innerText = 'Đã chọn';
                    setTimeout(function () { addButton.innerText = 'Chọn trước'; }, 900);
                    return;
                }

                var qtyButton = event.target.closest('.preorder-qty-controls button');

                if (qtyButton) {
                    var id = parseInt(qtyButton.dataset.id);
                    var action = qtyButton.dataset.action;
                    var item = cart.find(function (x) { return x.dishId === id; });

                    if (!item) return;

                    if (action === 'plus') {
                        item.quantity += 1;
                    } else {
                        item.quantity -= 1;
                    }

                    cart = cart.filter(function (x) { return x.quantity > 0; });
                    saveCart();
                    renderCart();
                }
            });

            document.getElementById('clearPreOrderBtn')?.addEventListener('click', function () {
                if (!cart.length) return;

                if (confirm('Xóa toàn bộ món đã chọn trước?')) {
                    cart = [];
                    saveCart();
                    renderCart();
                }
            });

            document.getElementById('preOrderToggle')?.addEventListener('click', function () {
                var panel = document.getElementById('preOrderPanel');

                if (!panel) return;

                var isCollapsed = panel.classList.contains('is-collapsed');
                setPanelCollapsed(!isCollapsed);
            });

                renderCart();
                syncPanelForMobile();

                mobileQuery.addEventListener?.('change', function () {
                    syncPanelForMobile();
                });
                })();
    </script>
}
