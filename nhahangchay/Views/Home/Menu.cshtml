@model IEnumerable<nhahangchay.Models.Dish>
@using System.Globalization

@{
    ViewData["Title"] = "Thực đơn SenVie";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCategory = ViewBag.CurrentCategory as string ?? "";
}

<div class="senvie-full-menu-page">
    <div class="container">

        <div class="full-menu-hero text-center">
            <p class="menu-eyebrow">SenVie Vegan Dining</p>
            <h1>Thực Đơn Chay</h1>
            <p>
                Chọn trước vài món để SenVie chuẩn bị nhanh hơn khi bạn đến nhà hàng.
                Việc chọn món chỉ là tạm tính, thanh toán trực tiếp tại nhà hàng.
            </p>
        </div>

        <div class="menu-filter-bar">
            <a asp-controller="Home"
               asp-action="Menu"
               class="menu-filter-pill @(string.IsNullOrWhiteSpace(currentCategory) ? "active" : "")">
                Tất cả
            </a>

            @foreach (var category in categories)
            {
                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-category="@category"
                   class="menu-filter-pill @(currentCategory == category ? "active" : "")">
                    @category
                </a>
            }
        </div>

        <div class="preorder-info-strip">
            <strong>Gợi ý:</strong>
            Bạn có thể chọn món trước cho Bàn Tiêu Chuẩn hoặc Bàn VIP. Với Omakase Chay, bếp trưởng sẽ thiết kế thực đơn riêng nên không cần chọn món lẻ.
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row full-menu-grid">
                @foreach (var dish in Model)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(dish.ImageUrl)
                        ? Url.Content("~/uploads/no-image.jpg")
                        : dish.ImageUrl;

                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                        <div class="full-menu-card">
                            <div class="full-menu-img">
                                <img src="@imageUrl" alt="@dish.Name" />
                            </div>

                            <div class="full-menu-body">
                                <span class="full-menu-category">@dish.Category</span>

                                <h3>@dish.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                {
                                    <p>@dish.Description</p>
                                }
                                else
                                {
                                    <p>Món chay thanh vị, được chế biến từ nguyên liệu tươi ngon trong ngày.</p>
                                }

                                <div class="full-menu-footer">
                                    <strong>@dish.Price.ToString("N0")đ</strong>

                                    <button type="button"
                                            class="preorder-add-btn js-add-preorder"
                                            data-dish-id="@dish.Id"
                                            data-name="@dish.Name"
                                            data-price="@dish.Price.ToString(CultureInfo.InvariantCulture)">
                                        Chọn trước
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="menu-empty-state">
                <h4>Chưa có món phù hợp</h4>
                <p>Vui lòng chọn danh mục khác hoặc quay lại sau.</p>
                <a asp-controller="Home" asp-action="Index">Quay về trang chủ</a>
            </div>
        }
    </div>
</div>

<div id="preOrderPanel" class="preorder-panel">
    <div class="preorder-panel-header">
        <div>
            <strong>Món chọn trước</strong>
            <span id="preOrderCount">0 món</span>
        </div>
        <button type="button" id="preOrderToggle" class="preorder-toggle-btn">Thu gọn</button>
    </div>

    <div id="preOrderBody" class="preorder-panel-body">
        <div id="preOrderEmpty" class="preorder-empty">Bạn chưa chọn món nào.</div>
        <div id="preOrderItems"></div>

        <div class="preorder-total-row">
            <span>Tổng tạm tính</span>
            <strong id="preOrderTotal">0đ</strong>
        </div>

        <div class="preorder-note">
            Tổng tiền món chỉ là tạm tính, thanh toán tại nhà hàng.
        </div>

        <div class="preorder-actions">
            <button type="button" id="clearPreOrderBtn" class="preorder-clear-btn">Xóa món</button>
            <a href="/#contact" class="preorder-continue-btn">Tiếp tục đặt bàn</a>
        </div>
    </div>
</div>

