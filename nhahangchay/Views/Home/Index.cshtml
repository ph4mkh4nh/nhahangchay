<!-- FORM ĐỘNG -->
@section Scripts {
    <script>
        $(document).ready(function () {
            function padDatePart(value) {
                return String(value).padStart(2, '0');
            }

            function getMinBookingDate() {
                var minDate = new Date();
                minDate.setMinutes(minDate.getMinutes() + 60);
                minDate.setSeconds(0);
                minDate.setMilliseconds(0);

                return minDate;
            }

            function toDateTimeLocalValue(date) {
                var year = date.getFullYear();
                var month = padDatePart(date.getMonth() + 1);
                var day = padDatePart(date.getDate());
                var hours = padDatePart(date.getHours());
                var minutes = padDatePart(date.getMinutes());

                return year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
            }

            function formatVietnamDateTime(date) {
                return padDatePart(date.getDate()) + '/' +
                    padDatePart(date.getMonth() + 1) + '/' +
                    date.getFullYear() + ' lúc ' +
                    padDatePart(date.getHours()) + ':' +
                    padDatePart(date.getMinutes());
            }

            function updateBookingDateMin() {
                var input = document.getElementById('bookingDateInput');

                if (!input) {
                    return null;
                }

                var minDate = getMinBookingDate();
                input.min = toDateTimeLocalValue(minDate);

                return minDate;
            }

            function showBookingDateError(message) {
                $('#bookingDateClientError')
                    .text(message)
                    .show();
            }

            function hideBookingDateError() {
                $('#bookingDateClientError')
                    .text('')
                    .hide();
            }

            function getBookingDateErrorMessage(minDate) {
                return 'Vui lòng chọn thời gian từ ' +
                    formatVietnamDateTime(minDate) +
                    ' trở đi để nhà hàng có ít nhất 1 tiếng chuẩn bị món và không gian.';
            }

            function validateBookingDate(showMessage) {
                var input = document.getElementById('bookingDateInput');

                if (!input) {
                    return true;
                }

                var minDate = updateBookingDateMin();
                var selectedValue = input.value;

                input.setCustomValidity('');
                hideBookingDateError();

                if (!selectedValue) {
                    return true;
                }

                var selectedDate = new Date(selectedValue);

                if (selectedDate < minDate) {
                    var message = getBookingDateErrorMessage(minDate);

                    input.setCustomValidity(message);

                    if (showMessage) {
                        showBookingDateError(message);
                    }

                    return false;
                }

                return true;
            }

            var bookingDateInput = document.getElementById('bookingDateInput');

            if (bookingDateInput) {
                updateBookingDateMin();

                bookingDateInput.addEventListener('focus', function () {
                    updateBookingDateMin();
                });

                bookingDateInput.addEventListener('click', function () {
                    updateBookingDateMin();
                });

                bookingDateInput.addEventListener('input', function () {
                    validateBookingDate(false);
                });

                bookingDateInput.addEventListener('change', function () {
                    validateBookingDate(true);
                });

                bookingDateInput.addEventListener('blur', function () {
                    validateBookingDate(true);
                });

                bookingDateInput.addEventListener('invalid', function () {
                    var minDate = updateBookingDateMin();
                    var message = getBookingDateErrorMessage(minDate);

                    if (!bookingDateInput.value) {
                        message = 'Vui lòng chọn thời gian đến nhà hàng.';
                    }

                    bookingDateInput.setCustomValidity(message);
                    showBookingDateError(message);
                });
            }

            $('#realBookingForm').on('submit', function (e) {
                if (!validateBookingDate(true)) {
                    e.preventDefault();

                    if (bookingDateInput) {
                        bookingDateInput.reportValidity();
                        bookingDateInput.focus();
                    }

                    return false;
                }
            });

            // 2. PRE-ORDER MÓN CHỌN TRƯỚC

            var preOrderStorageKey = "senvie_preorder_items";

            function loadPreOrderCart() {
                try {
                    return JSON.parse(localStorage.getItem(preOrderStorageKey) || "[]");
                } catch (e) {
                    return [];
                }
            }

            function savePreOrderCart(cart) {
                localStorage.setItem(preOrderStorageKey, JSON.stringify(cart || []));
            }

            function formatPreOrderMoney(value) {
                return (value || 0).toLocaleString('vi-VN') + 'đ';
            }

            function updatePreOrderSummary(bookingType) {
                var cart = loadPreOrderCart();
                var summaryBox = $('#preOrderSummaryDiv');
                var summaryItems = $('#preOrderSummaryItems');
                var summaryTotal = $('#preOrderSummaryTotal');
                var hiddenInput = $('#preOrderJson');

                summaryItems.empty();

                if (bookingType === 'Omakase Chay') {
                    hiddenInput.val('');

                    if (cart.length > 0) {
                        summaryBox.show();
                        summaryItems.html('<div class="text-warning font-weight-bold">Omakase Chay là trải nghiệm do bếp trưởng thiết kế nên không áp dụng chọn món lẻ. Các món đã chọn trước sẽ không được gửi kèm đơn này.</div>');
                        summaryTotal.text('0đ');
                    } else {
                        summaryBox.hide();
                    }

                    return;
                }

                if (!cart.length) {
                    hiddenInput.val('');
                    summaryBox.hide();
                    return;
                }

                var total = 0;
                var submitItems = [];

                cart.forEach(function (item) {
                    var quantity = parseInt(item.quantity) || 1;
                    var price = parseFloat(item.price) || 0;

                    total += quantity * price;

                    submitItems.push({
                        dishId: item.dishId,
                        quantity: quantity
                    });

                    $('<div></div>')
                        .addClass('d-flex justify-content-between mb-1')
                        .html('<span>' + item.name + ' x ' + quantity + '</span><strong>' + formatPreOrderMoney(quantity * price) + '</strong>')
                        .appendTo(summaryItems);
                });

                hiddenInput.val(JSON.stringify(submitItems));
                summaryTotal.text(formatPreOrderMoney(total));
                summaryBox.show();
            }

            window.clearPreOrderFromBookingForm = function () {
                if (!confirm('Xóa toàn bộ món đã chọn trước?')) {
                    return;
                }

                savePreOrderCart([]);
                updatePreOrderSummary($('#bookingTypeSelect').val());
            };

            // 3. VIP / OMAKASE / TIỀN CỌC
            function updateDynamicForm() {
                var bookingType = $('#bookingTypeSelect').val();
                var guests = parseInt($('#numberOfGuestsInput').val()) || 1;

                if (bookingType === 'Bàn Tiêu Chuẩn') {
                    $('#vipOptionsDiv').slideUp();
                    $('#omakaseOptionsDiv').slideUp();
                    $('#depositInfoDiv').slideUp();

                    $('#hiddenDepositAmount').val(0);

                    $('#specialRequestLabel').html('<i class="far fa-comment-dots text-success mr-1"></i> Yêu cầu đặc biệt (Nếu có):');
                    $('#specialRequestInput').attr('placeholder', 'Ví dụ: Không hành tỏi, thích ngồi gần cửa sổ...');
                }
                else if (bookingType === 'Bàn VIP') {
                    $('#vipOptionsDiv').slideDown();
                    $('#omakaseOptionsDiv').slideUp();
                    $('#depositInfoDiv').slideDown();

                    var vipDeposit = 1000000;

                    $('#hiddenDepositAmount').val(vipDeposit);
                    $('#depositAmountText').text(vipDeposit.toLocaleString('vi-VN') + ' VNĐ');
                    $('#depositDescription').text('Phí giữ phòng VIP biệt lập & cam kết không gian.');

                    $('#specialRequestLabel').html('<i class="fas fa-gift text-danger mr-1"></i> Ghi chú Trang trí / Custom (Nếu có):');
                    $('#specialRequestInput').attr('placeholder', 'Ví dụ: Setup hoa hồng, nến, bóng bay sinh nhật...');
                }
                else if (bookingType === 'Omakase Chay') {
                    $('#vipOptionsDiv').slideUp();
                    $('#omakaseOptionsDiv').slideDown();
                    $('#depositInfoDiv').slideDown();

                    var tierPrice = parseInt($('#omakaseTierSelect').find(':selected').data('price')) || 0;
                    var omakaseDeposit = (tierPrice * guests) * 0.5;

                    $('#hiddenDepositAmount').val(omakaseDeposit);
                    $('#depositAmountText').text(omakaseDeposit.toLocaleString('vi-VN') + ' VNĐ');
                    $('#depositDescription').text('Cọc 50% trải nghiệm Omakase cho ' + guests + ' khách.');

                    $('#specialRequestLabel').html('<i class="fas fa-exclamation-triangle text-warning mr-1"></i> Ghi chú Dị ứng thực phẩm (Bắt buộc):');
                    $('#specialRequestInput').attr('placeholder', 'Ví dụ: Dị ứng đậu phộng, không ăn cay, dị ứng gluten...');
                }

                updatePreOrderSummary(bookingType);
            }

            $('#bookingTypeSelect, #numberOfGuestsInput, #omakaseTierSelect').on('change keyup', function () {
                updateDynamicForm();
            });

            updateDynamicForm();
        });
    </script>
}

