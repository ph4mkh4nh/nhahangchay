<script>
    function selectBookingService(serviceValue) {
        var selectElement = document.getElementById('bookingTypeSelect') || document.getElementById('txtBookingType');

        if (selectElement) {
            selectElement.value = serviceValue;
            selectElement.dispatchEvent(new Event('change'));
        } else {
            console.warn("Không tìm thấy ô chọn Loại Bàn ở dưới Form!");
        }
    }
</script>

<!--form đặt bàn-->
<div id="contact" class="section db" style="padding: 40px 0; background-attachment: fixed;">
    <div class="container">
        <div class="section-title text-center" style="margin-bottom: 25px;">
            <h2 style="color: #ffffff; font-size: 32px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-family: inherit;">
                Đặt Bàn & Ghé Thăm SenVie
            </h2>
            <p style="color: rgba(255, 255, 255, 0.92); font-size: 15px; font-style: italic; max-width: 760px; margin: 10px auto 0; font-family: inherit;">
                Chọn thời gian dùng bữa, không gian phù hợp và xem đường đi đến nhà hàng.
            </p>
            <p style="color: rgba(255, 255, 255, 0.9); font-size: 15px; font-style: italic; max-width: 700px; margin: 10px auto 0; font-family: inherit;">
                "Hân hạnh được chuẩn bị không gian thanh tịnh cùng những món ăn chay bổ dưỡng cho hành trình ẩm thực của quý khách."
            </p>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="custom-booking-form" style="max-width: 850px; margin: 0 auto; background: rgba(255, 255, 255, 0.96); padding: 25px 35px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.2);">
                    <form id="realBookingForm"
                          asp-controller="Home"
                          asp-action="SubmitBooking"
                          method="post"
                          class="js-customer-submit-once"
                          data-loading-text="Đang gửi yêu cầu đặt bàn...">
                        <div class="row">

                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="col-md-12 mb-2">
                                    <div class="alert alert-success text-center font-weight-bold py-2 mb-2" style="border-radius: 5px; font-size: 14px;"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
                                </div>
                            }
                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="col-md-12 mb-2">
                                    <div class="alert alert-danger text-center font-weight-bold py-2 mb-2" style="border-radius: 5px; font-size: 14px;"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
                                </div>
                            }

                            <!--  CHỌN LOẠI BÀN -->
                            <div class="col-md-12 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;"><i class="fas fa-utensils text-success mr-1"></i> Lựa chọn không gian:</label>
                                    <select class="form-control custom-input" id="bookingTypeSelect" name="BookingType" required style="cursor: pointer; font-weight: 600;">
                                        <option value="Bàn Tiêu Chuẩn">Bàn Tiêu Chuẩn (Không gian chung - Miễn phí)</option>
                                        <option value="Bàn VIP">Bàn VIP (Phòng Riêng biệt lập - Có phí giữ chỗ)</option>
                                        <option value="Omakase Chay">Omakase Chay (Trải nghiệm Chef's Table)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- MODULE: OPTION CHO BÀN VIP (ẨN/HIỆN ĐỘNG) -->
                            <div class="col-md-12 mb-2" id="vipOptionsDiv" style="display: none;">
                                <div class="form-group mb-0" style="background-color: #f1f8eb; padding: 12px; border-left: 4px solid #7DBA4E; border-radius: 5px;">
                                    <label class="font-weight-bold text-success mb-1" style="font-size: 13px;"><i class="fas fa-gift mr-1"></i> Dịch vụ Custom Không Gian (Offline):</label>
                                    <p class="mb-1" style="font-size: 12px; color: #555;">Lễ tân sẽ liên hệ trực tiếp để báo giá trang trí hoa tươi, nến, bóng bay theo yêu cầu riêng của quý khách.</p>
                                </div>
                            </div>

                            <!-- MODULE: OPTION CHO OMAKASE (ẨN/HIỆN ĐỘNG) -->
                            <div class="col-md-12 mb-2" id="omakaseOptionsDiv" style="display: none;">
                                <div class="form-group mb-0" style="background-color: #fff3cd; padding: 12px; border-left: 4px solid #ffc107; border-radius: 5px;">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 13px;"><i class="fas fa-leaf text-warning mr-1"></i> Chọn phân hạng Omakase:</label>
                                    <select id="omakaseTierSelect" name="OmakaseTier" class="form-control custom-input">
                                        <option value="Tĩnh Tại" data-price="1500000">Gói "Tĩnh Tại" (7 món cơ bản) - 1.500.000đ / Khách</option>
                                        <option value="Tinh Hoa" data-price="2500000">Gói "Tinh Hoa" (9 món & Trà) - 2.500.000đ / Khách</option>
                                        <option value="Nghệ Nhân" data-price="4000000">Gói "Nghệ Nhân" (12 món thượng hạng) - 4.000.000đ / Khách</option>
                                    </select>
                                </div>
                            </div>

                            <!--  THÔNG TIN KHÁCH HÀNG -->
                            <div class="col-md-6 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Họ và tên *</label>
                                    <input type="text" class="form-control custom-input" name="CustomerName" value="@ViewBag.CustomerName" placeholder="Nhập tên..." required @(string.IsNullOrEmpty(ViewBag.CustomerName) ? "" : "readonly") style="@(string.IsNullOrEmpty(ViewBag.CustomerName) ? "" : "background-color: #e9ecef !important; cursor: not-allowed;")">
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Số điện thoại *</label>
                                    <input type="text" class="form-control custom-input" name="PhoneNumber" placeholder="Nhập số điện thoại..." required>
                                </div>
                            </div>

                            <div class="col-md-6 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Địa chỉ Email *</label>
                                    <input type="email" class="form-control custom-input" name="Email" value="@ViewBag.CustomerEmail" placeholder="ví_dụ@gmail.com..." required @(string.IsNullOrEmpty(ViewBag.CustomerEmail) ? "" : "readonly") style="@(string.IsNullOrEmpty(ViewBag.CustomerEmail) ? "" : "background-color: #e9ecef !important; cursor: not-allowed;")">
                                </div>
                            </div>

                            <div class="col-md-6 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;">Số lượng khách *</label>
                                    <input type="number" class="form-control custom-input" name="NumberOfGuests" id="numberOfGuestsInput" placeholder="Nhập số người..." min="1" value="1" required>
                                </div>
                            </div>

                            <div class="col-md-12 mb-2">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;">
                                        <i class="far fa-calendar-alt text-success mr-1"></i> Thời gian đến nhà hàng *
                                    </label>
                                    <div style="font-size: 13px; color: #333; font-style: italic; margin-bottom: 8px;">
                                        <span style="color: red;">✦</span>
                                        Quý khách vui lòng chọn thời gian sau hiện tại ít nhất <strong>1 tiếng</strong>.
                                    </div>
                                    <input type="datetime-local"
                                           name="BookingDate"
                                           id="bookingDateInput"
                                           class="form-control custom-input"
                                           required
                                           autocomplete="off" />

                                    <div id="bookingDateClientError"
                                         class="text-danger font-weight-bold mt-1"
                                         style="display:none; font-size: 13px;">
                                    </div>
                                </div>
                            </div>

                            <!-- GHI CHÚ (THAY ĐỔI LABEL THEO LOẠI BÀN) -->
                            <div class="col-md-12 mb-3">
                                <div class="form-group mb-0">
                                    <label class="font-weight-bold text-dark mb-1" style="font-size: 14px;" id="specialRequestLabel">
                                        <i class="far fa-comment-dots text-success mr-1"></i> Yêu cầu đặc biệt (Nếu có):
                                    </label>
                                    <textarea class="form-control custom-input" name="SpecialRequest" id="specialRequestInput" placeholder="Ví dụ: Không hành tỏi, thích ngồi gần cửa sổ..." rows="2" style="padding-top: 8px;"></textarea>
                                </div>
                            </div>

                            <!-- MODULE: HIỂN THỊ TIỀN CỌC -->
                            <div class="col-md-12 mb-3" id="depositInfoDiv" style="display: none;">
                                <div class="alert text-center mb-0" style="background-color: #fff; border: 2px dashed #d9534f; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05);">
                                    <h6 class="mb-1 text-danger font-weight-bold"><i class="fas fa-lock"></i> Yêu Cầu Đặt Cọc</h6>
                                    <h3 class="font-weight-bold text-danger mb-1" id="depositAmountText">0 VNĐ</h3>
                                    <p class="mb-0 text-muted" id="depositDescription" style="font-size: 13px;"></p>
                                </div>
                            </div>

                            <!-- MODULE: MÓN CHỌN TRƯỚC TỪ TRANG MENU -->
                            <div class="col-md-12 mb-3" id="preOrderSummaryDiv" style="display: none;">
                                <div class="alert mb-0" style="background-color: #f8fff4; border: 1px solid #d8edce; border-left: 4px solid #7DBA4E; border-radius: 10px;">
                                    <h6 class="mb-2 text-success font-weight-bold">Món bạn đã chọn trước</h6>
                                    <div id="preOrderSummaryItems" style="font-size: 13px; color: #333;"></div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2" style="border-top: 1px dashed #c9dfbd;">
                                        <small class="text-muted">Tổng tiền món chỉ là tạm tính, thanh toán tại nhà hàng.</small>
                                        <strong id="preOrderSummaryTotal" class="text-success">0đ</strong>
                                    </div>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger mt-2"
                                            onclick="clearPreOrderFromBookingForm()">
                                        Xóa món đã chọn
                                    </button>
                                </div>
                            </div>

                            <input type="hidden" name="preOrderJson" id="preOrderJson" value="" />

                            <!-- Input ẩn để gửi Số tiền cọc về Backend C# lưu vào Database -->
                            <input type="hidden" name="DepositAmount" id="hiddenDepositAmount" value="0" />

                            <div class="col-md-12 text-center mt-2">
                                <button type="submit" class="btn btn-success" style="background-color: #7DBA4E; color: white; padding: 10px 40px; font-weight: bold; font-size: 15px; text-transform: uppercase; border-radius: 30px; border: none; transition: all 0.3s;">
                                    Xác Nhận Đặt Bàn
                                </button>
                            </div>
                        </div>
                    </form>               
                </div>
            </div>
        </div>
    </div>
</div>
<!--bản đồ nhà hàng-->
<div id="map" class="section wb senvie-map-section">
    <div class="container">
        <div class="section-title text-center senvie-map-title">
            <h3>Bản Đồ & Thông Tin Liên Hệ</h3>
            <p>Xem đường đi đến SenVie và liên hệ nhà hàng khi cần hỗ trợ đặt bàn.</p>
        </div>

        @{
            var restaurantAddress = "141-145 Điện Biên Phủ, Phường Gia Định, TP.HCM, Việt Nam";
            var encodedMapAddress = Uri.EscapeDataString(restaurantAddress);
            var googleMapEmbedUrl = $"https://www.google.com/maps?q={encodedMapAddress}&output=embed";
            var googleMapOpenUrl = $"https://www.google.com/maps/search/?api=1&query={encodedMapAddress}";
        }

        <div class="senvie-map-wide-card">
            <iframe src="@googleMapEmbedUrl"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>

            <a class="senvie-map-click-layer"
               href="@googleMapOpenUrl"
               target="_blank"
               rel="noopener"
               aria-label="Mở địa chỉ SenVie trên Google Maps">
            </a>

            <div class="senvie-map-floating-label">
                <i class="fa fa-map-marker"></i>
                <span>Nhấn vào bản đồ để mở Google Maps</span>
            </div>
        </div>

        <div class="senvie-contact-info-grid">
            <div class="senvie-contact-info-card">
                <div class="senvie-contact-icon">
                    <i class="fa fa-map-marker"></i>
                </div>
                <div>
                    <h4>Địa chỉ</h4>
                    <p>@restaurantAddress</p>
                </div>
            </div>

            <div class="senvie-contact-info-card">
