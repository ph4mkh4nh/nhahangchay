<!--menu-->
<div id="menu" class="section lb">
    <div class="container-fluid">
        <div class="section-title text-center">
            <h3>Món Chay Nổi Bật</h3>
            <p>
                Những món chay được SenVie gợi ý cho bữa ăn chính, phù hợp để khách chọn trước khi đặt bàn.
            </p>
        </div>

        @if (featuredDishes.Any())
        {
            <div class="row text-center senvie-featured-menu-row">
                @foreach (var dish in featuredDishes)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(dish.ImageUrl)
                        ? Url.Content("~/uploads/no-image.jpg")
                        : dish.ImageUrl;

                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                        <div class="senvie-featured-dish-card">
                            <div class="senvie-featured-dish-image">
                                <img src="@imageUrl" alt="@dish.Name" />
                            </div>

                            <div class="senvie-featured-dish-body">
                                <h3>@dish.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                {
                                    <p>
                                        @(dish.Description.Length > 70
                                            ? dish.Description.Substring(0, 70) + "..."
                                            : dish.Description)
                                    </p>
                                }
                                else
                                {
                                    <p>Món chay thanh vị, được chế biến từ nguyên liệu tươi ngon.</p>
                                }

                                <div class="senvie-dish-price">
                                    @dish.Price.ToString("N0")đ
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home"
                   asp-action="Menu"
                   class="senvie-view-menu-btn">
                    Xem Thực Đơn Đầy Đủ
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-muted">Thực đơn đang được cập nhật</h4>
                <p class="text-muted">Vui lòng quay lại sau hoặc liên hệ nhà hàng để được tư vấn món ăn.</p>
            </div>
        }
    </div>
</div>

