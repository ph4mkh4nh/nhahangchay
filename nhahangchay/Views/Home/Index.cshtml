@using nhahangchay.Models
@using System.Collections.Generic

@{
    var featuredDishes = ViewBag.FeaturedDishes as List<Dish> ?? new List<Dish>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/home-mobile.css" asp-append-version="true" />
}
<style>
    #mainNav .navbar-nav .nav-link,
    #mainNav .navbar-nav li a,
    .navbar .navbar-nav .nav-link,
    .navbar .navbar-nav li a {
        color: #3f4a3f !important;
        opacity: 1 !important;
        font-weight: 600 !important;
        letter-spacing: 0.2px;
    }

        #mainNav .navbar-nav .nav-link:hover,
        #mainNav .navbar-nav li a:hover,
        .navbar .navbar-nav .nav-link:hover,
        .navbar .navbar-nav li a:hover {
            color: #7DBA4E !important;
        }

    #mainNav .navbar-nav .active > .nav-link,
    #mainNav .navbar-nav li.active > a,
    .navbar .navbar-nav .active > .nav-link,
    .navbar .navbar-nav li.active > a {
        color: #ffffff !important;
        opacity: 1 !important;
        font-weight: 700 !important;
    }

    .message-box .senvie-about-highlights {
        list-style: none;
        padding: 0;
        margin: 24px 0 0;
    }

        .message-box .senvie-about-highlights li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 10px;
            padding: 13px 16px;
            border-radius: 10px;
            background: #f6f9f3;
            border: 1px solid #e1ebda;
            color: #283528 !important;
            font-weight: 700;
            line-height: 1.5;
            cursor: default !important;
            transition: none !important;
            transform: none !important;
        }

            .message-box .senvie-about-highlights li:nth-child(even) {
                background: #fffaf6;
                border-color: #eadbd3;
            }

            .message-box .senvie-about-highlights li:hover {
                background: #f6f9f3 !important;
                color: #283528 !important;
                transform: none !important;
                box-shadow: none !important;
            }

            .message-box .senvie-about-highlights li:nth-child(even):hover {
                background: #fffaf6 !important;
            }

    .senvie-about-check {
        width: 24px;
        height: 24px;
        min-width: 24px;
        border-radius: 50%;
        background: #7DBA4E;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 900;
        margin-top: 1px;
    }

    .senvie-service-row {
        margin-top: 28px;
    }

    .senvie-service-card {
        height: 100%;
        background: #ffffff;
        border-radius: 22px;
        border: 1px solid #e3eadf;
        box-shadow: 0 14px 34px rgba(30, 55, 30, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: 0.25s ease;
    }

        .senvie-service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 42px rgba(30, 55, 30, 0.12);
        }

    .senvie-service-head {
        padding: 26px 24px 20px;
        background: linear-gradient(135deg, #f8fff4 0%, #ffffff 100%);
        border-bottom: 1px solid #edf3e9;
        min-height: 210px;
        position: relative;
    }

        .senvie-service-head.vip {
            background: linear-gradient(135deg, #eff9e8 0%, #ffffff 100%);
        }

        .senvie-service-head.omakase {
            background: linear-gradient(135deg, #fff9ea 0%, #ffffff 100%);
        }

    .senvie-service-label {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: #edf7e8;
        color: #4d7f2f;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .senvie-service-card h3 {
        color: #203420;
        font-size: 26px;
        font-weight: 900;
        margin: 0 0 12px;
        line-height: 1.25;
    }

    .senvie-service-price {
        color: #7DBA4E;
        font-size: 24px;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .senvie-service-desc {
        color: #667066;
        font-size: 14px;
        line-height: 1.65;
        margin: 0;
    }

    .senvie-service-body {
        padding: 22px 24px 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .senvie-service-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px;
    }

        .senvie-service-list li {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
            color: #314031;
            font-size: 14px;
            line-height: 1.55;
        }

            .senvie-service-list li::before {
                content: "✓";
                color: #7DBA4E;
                font-weight: 900;
                margin-top: 1px;
            }

    .senvie-service-note {
        margin-top: auto;
        padding: 13px 14px;
        border-radius: 14px;
        background: #f7faf4;
        color: #607060;
        font-size: 13px;
        line-height: 1.55;
        border: 1px dashed #d7e6cf;
    }

    .senvie-service-btn {
        margin-top: 16px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        height: 44px;
        border-radius: 999px;
        background: #1f3b20;
        color: #ffffff !important;
        font-weight: 900;
        text-decoration: none !important;
        box-shadow: 0 8px 20px rgba(31, 59, 32, 0.16);
        transition: 0.2s ease;
    }

        .senvie-service-btn:hover {
            background: #7DBA4E;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .senvie-service-head {
            min-height: auto;
        }

        .senvie-service-card h3 {
            font-size: 23px;
        }
    }
</style>
