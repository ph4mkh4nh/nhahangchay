@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Đặt lại mật khẩu - SenVie</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">

    <style>
            html, body {
                width: 100%;
                min-height: 100%;
                margin: 0;
                overflow-x: hidden;
            }

            body {
                min-height: 100vh;
                min-height: 100svh;
                padding: 24px 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(rgba(0,0,0,.58), rgba(0,0,0,.58)), url('/uploads/slider-01.png') center center / cover no-repeat;
                font-family: Arial, Helvetica, sans-serif;
            }

            .auth-shell {
                width: 100%;
                max-width: 450px;
                margin: 0 auto;
            }

            .auth-card {
                border: none;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 55px rgba(0,0,0,.26);
            }

                .auth-card .card-body {
                    padding: 34px 32px;
                }

            .auth-icon {
                color: #7DBA4E;
                font-size: 42px;
            }

            .auth-title {
                margin: 12px 0 8px;
                color: #172236;
                font-size: 25px;
                line-height: 1.25;
                font-weight: 900;
                text-align: center;
                text-transform: uppercase;
            }

            .auth-subtitle {
                color: #6f7780;
                font-size: 14px;
                line-height: 1.55;
                text-align: center;
                margin-bottom: 0;
                word-break: break-word;
            }

            .auth-form label {
                color: #1f2a33;
                font-size: 14px;
                font-weight: 800;
            }

            .auth-form .input-group-text {
                width: 46px;
                min-height: 46px;
                justify-content: center;
                border-color: #d8e0d5;
                background: #fff;
            }

            .auth-form .form-control {
                min-height: 46px;
                border-color: #d8e0d5;
                font-size: 16px;
                box-shadow: none;
            }

            .auth-submit-btn {
                min-height: 50px;
                border: none;
                border-radius: 999px;
                background: #7DBA4E;
                color: white;
                font-size: 15px;
                font-weight: 900;
            }

                .auth-submit-btn:hover {
                    background: #659f3d;
                    color: white;
                }

            .auth-links {
                margin-top: 22px;
                text-align: center;
                font-size: 14px;
            }

                .auth-links a {
                    color: #6f7780;
                    text-decoration: none;
                }

                    .auth-links a:hover {
                        color: #7DBA4E;
                    }

            @@media (max-width:575.98px) {
                body {
                    align-items: flex-start;
                    padding: 18px 12px;
                    background-attachment: scroll;
                }

                .auth-card {
                    border-radius: 20px;
                }

                    .auth-card .card-body {
                        padding: 28px 22px;
                    }

                .auth-title {
                    font-size: 23px;
                }
            }
    </style>
</head>
<body>
    <main class="auth-shell">
        <div class="card auth-card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fas fa-lock auth-icon"></i>
                    <h3 class="auth-title">Đặt lại mật khẩu</h3>
                    <p class="auth-subtitle">@email</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center font-weight-bold">@ViewBag.Error</div>
                }

                <form asp-controller="Account" asp-action="ResetPassword" method="post" class="auth-form js-customer-submit-once" data-loading-text="Đang cập nhật mật khẩu...">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="email" value="@email" />
                    <input type="hidden" name="token" value="@token" />

                    <div class="form-group mb-3">
                        <label>Mật khẩu mới</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fas fa-lock text-muted"></i>
                                </span>
                            </div>
                            <input type="password" name="password" class="form-control border-left-0" placeholder="Ít nhất 6 ký tự" minlength="6" required>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label>Nhập lại mật khẩu mới</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fas fa-shield-alt text-muted"></i>
                                </span>
                            </div>
                            <input type="password" name="confirmPassword" class="form-control border-left-0" placeholder="Nhập lại mật khẩu" minlength="6" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-block auth-submit-btn">
                        Cập nhật mật khẩu
                    </button>
                </form>

                <div class="auth-links">
                    <a href="/Account/Login">
                        <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </main>

    <script src="~/js/customer-common.js" asp-append-version="true"></script>
</body>
</html>