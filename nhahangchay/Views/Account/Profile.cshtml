<div class="modal fade" id="qrModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content senvie-modal-content">
            <div class="modal-header border-0 pb-0 senvie-modal-header">
                <h5 class="modal-title senvie-modal-title">Mã Check-in</h5>
                <button type="button" class="close senvie-modal-close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" class="senvie-close-icon">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center pt-2 pb-4">
                <p class="text-muted mb-3 senvie-modal-note">Vui lòng đưa mã QR này cho Lễ tân</p>
                <img id="qrImage" src="" alt="QR Code" class="senvie-qr-image" />
                <h3 id="qrCodeText" class="senvie-qr-code-text mb-0"></h3>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-show-qr').click(function () {
                var bookingCode = ($(this).attr('data-code') || '').trim();

                if (!bookingCode) {
                    alert('Không tìm thấy mã đặt bàn để tạo QR.');
                    return;
                }

                var qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=" + encodeURIComponent(bookingCode);

                $('#qrImage').attr('src', qrUrl);
                $('#qrCodeText').text(bookingCode);
                $('#qrModal').modal('show');
            });

            @if (unpaidBookings.Any())
            {
                        <text>
                                    $('#payment-tab').tab('show');

                                    setTimeout(function () {
                                        alert("⚠️ CẢNH BÁO TỪ SENVIE: \n\nBạn đang có @unpaidBookings.Count đơn đặt bàn VIP/Omakase chưa hoàn tất thanh toán cọc. \n\nHệ thống sẽ tự động HỦY đơn nếu quá 15 phút kể từ lúc đặt. Vui lòng thanh toán ngay để giữ chỗ!");
                                    }, 500);
                        </text>
            }
        });
    </script>
}
