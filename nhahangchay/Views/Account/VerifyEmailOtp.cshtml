@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác nhận email - SenVie</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.css" />

    <style>
            body {
                min-height: 100vh;
                margin: 0;
                background: linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)), url('/uploads/slider-02.png') center/cover no-repeat;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: inherit;
            }

            .otp-card {
                width: 100%;
                max-width: 460px;
                background: #fff;
                border-radius: 22px;
                padding: 36px;
                box-shadow: 0 22px 60px rgba(0,0,0,.22);
            }

            .otp-icon {
                width: 68px;
                height: 68px;
                border-radius: 50%;
                background: #eef8e8;
                color: #7DBA4E;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 18px;
                font-size: 30px;
            }

            .otp-title {
                text-align: center;
                font-size: 28px;
                font-weight: 900;
                color: #122033;
                margin-bottom: 8px;
            }

            .otp-desc {
                text-align: center;
                color: #667085;
                line-height: 1.6;
                margin-bottom: 24px;
            }

            .otp-input {
                text-align: center;
                font-size: 24px;
                letter-spacing: 8px;
                font-weight: 800;
                height: 54px;
            }

            .btn-senvie {
                width: 100%;
                height: 52px;
                border: none;
                border-radius: 999px;
                background: #7DBA4E;
                color: #fff;
                font-weight: 900;
            }

                .btn-senvie:hover {
                    background: #1f3b20;
                    color: #fff;
                }

            .resend-btn {
                border: none;
                background: transparent;
                color: #7DBA4E;
                font-weight: 800;
                padding: 0;
            }

            .back-link {
                color: #667085;
                text-decoration: none;
            }
    </style>
</head>

<body>
    <div class="otp-card">
        <div class="otp-icon">
            <i class="fas fa-envelope-open-text"></i>
        </div>

        <h1 class="otp-title">Xác nhận email</h1>

        <p class="otp-desc">
            SenVie đã gửi mã OTP đến email:<br />
            <strong>@email</strong>
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center font-weight-bold">
                @ViewBag.Error
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center font-weight-bold">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info text-center font-weight-bold">
                @TempData["InfoMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center font-weight-bold">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="VerifyEmailOtp" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="email" value="@email" />

            <div class="form-group">
                <label class="font-weight-bold">Mã OTP</label>
                <input type="text"
                       name="otp"
                       class="form-control otp-input"
                       maxlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       placeholder="------"
                       required />
            </div>

            <button type="submit" class="btn-senvie mt-3">
                XÁC NHẬN TÀI KHOẢN
            </button>
        </form>

        <form asp-controller="Account" asp-action="ResendEmailOtp" method="post" class="text-center mt-4">
            @Html.AntiForgeryToken()

            <input type="hidden" name="email" value="@email" />

            <span class="text-muted">Chưa nhận được mã?</span>
            <button type="submit" class="resend-btn">
                Gửi lại OTP
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/Account/Login" class="back-link">
                <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
            </a>
        </div>
    </div>
</body>
</html>