@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Quên mật khẩu - SenVie</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">

    <style>
            html, body {
                width: 100%;
                min-height: 100%;
                margin: 0;
                overflow-x: hidden;
            }

            body {
                min-height: 100vh;
                min-height: 100svh;
                padding: 24px 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(rgba(0,0,0,.58), rgba(0,0,0,.58)), url('/uploads/slider-01.png') center center / cover no-repeat;
                font-family: Arial, Helvetica, sans-serif;
            }

            .auth-shell {
                width: 100%;
                max-width: 450px;
                margin: 0 auto;
            }

            .auth-card {
                border: none;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 55px rgba(0,0,0,.26);
            }

                .auth-card .card-body {
                    padding: 34px 32px;
                }

            .auth-icon {
                color: #7DBA4E;
                font-size: 42px;
            }

            .auth-title {
                margin: 12px 0 8px;
                color: #172236;
                font-size: 25px;
                line-height: 1.25;
                font-weight: 900;
                text-align: center;
                text-transform: uppercase;
            }

            .auth-subtitle {
                color: #6f7780;
                font-size: 14px;
                line-height: 1.55;
                text-align: center;
                margin-bottom: 0;
            }

            .auth-form label {
                color: #1f2a33;
                font-size: 14px;
                font-weight: 800;
            }

            .auth-form .input-group-text {
                width: 46px;
                min-height: 46px;
                justify-content: center;
                border-color: #d8e0d5;
                background: #fff;
            }

            .auth-form .form-control {
                min-height: 46px;
                border-color: #d8e0d5;
                font-size: 16px;
                box-shadow: none;
            }

            .auth-submit-btn {
                min-height: 50px;
                border: none;
                border-radius: 999px;
                background: #7DBA4E;
                color: white;
                font-size: 15px;
                font-weight: 900;
            }

                .auth-submit-btn:hover {
                    background: #659f3d;
                    color: white;
                }

            .auth-links {
                margin-top: 22px;
                text-align: center;
                font-size: 14px;
                line-height: 1.7;
            }

                .auth-links a {
                    color: #6f7780;
                    text-decoration: none;
                }

                    .auth-links a:hover {
                        color: #7DBA4E;
                    }

            @@media (max-width:575.98px) {
                body {
                    align-items: flex-start;
                    padding: 18px 12px;
                    background-attachment: scroll;
                }

                .auth-card {
                    border-radius: 20px;
                }

                    .auth-card .card-body {
                        padding: 28px 22px;
                    }

                .auth-title {
                    font-size: 23px;
                }
            }

            .auth-card,
            .auth-card * {
                box-sizing: border-box;
            }

            .auth-card {
                width: 100%;
                max-width: 450px;
                margin-left: auto;
                margin-right: auto;
            }

            .auth-title,
            .auth-subtitle,
            .auth-form label,
            .auth-form input,
            .auth-submit-btn,
            .auth-links {
                font-family: Arial, Helvetica, sans-serif;
            }

            .auth-submit-btn {
                width: 100%;
                min-height: 50px;
                padding: 12px 18px;
                border: none;
                border-radius: 999px;
                background: #7DBA4E;
                color: #ffffff;
                font-size: 15px;
                font-weight: 900;
                letter-spacing: 0.2px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                white-space: nowrap;
            }

                .auth-submit-btn:hover {
                    background: #659f3d;
                    color: #ffffff;
                }

                .auth-submit-btn:disabled {
                    opacity: 0.75;
                    cursor: not-allowed;
                }

                .auth-submit-btn .btn-loading-text {
                    display: none;
                }

                .auth-submit-btn.is-loading .btn-normal-text {
                    display: none;
                }

                .auth-submit-btn.is-loading .btn-loading-text {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                }

            @@media (max-width: 575.98px) {
                .auth-shell {
                    max-width: 430px;
                }

                .auth-card {
                    max-width: 100%;
                }

                .auth-submit-btn {
                    font-size: 15px;
                    white-space: normal;
                }
            }
    </style>
</head>
<body>
    <main class="auth-shell">
        <div class="card auth-card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fas fa-key auth-icon"></i>
                    <h3 class="auth-title">Quên mật khẩu</h3>
                    <p class="auth-subtitle">Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center font-weight-bold">@ViewBag.Error</div>
                }

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success text-center font-weight-bold">@ViewBag.Success</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form" id="forgotPasswordForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-4">
                        <label>Địa chỉ Email</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope text-muted"></i>
                                </span>
                            </div>
                            <input type="email" name="email" class="form-control border-left-0" placeholder="email@gmail.com" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-block auth-submit-btn" id="forgotPasswordSubmitBtn">
                        <span class="btn-normal-text">Gửi email đặt lại</span>
                        <span class="btn-loading-text">
                            <i class="fas fa-circle-notch fa-spin"></i>
                            Đang gửi email...
                        </span>
                    </button>
                </form>

                <div class="auth-links">
                    <a href="/Account/Login">
                        <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
                    </a>
                    <br />
                    <a href="/">Về trang chủ</a>
                </div>
            </div>
        </div>
    </main>
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                var form = document.getElementById("forgotPasswordForm");
                var submitBtn = document.getElementById("forgotPasswordSubmitBtn");

                if (!form || !submitBtn) {
                    return;
                }

                form.addEventListener("submit", function () {
                    if (!form.checkValidity()) {
                        return;
                    }

                    submitBtn.disabled = true;
                    submitBtn.classList.add("is-loading");
                });
            });
    </script>
</body>
</html>